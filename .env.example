# Copied to .env by `make setup`. Never commit .env.

# PostgreSQL (used by the db service and by the API)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

# Auth0 (see docs/auth0-setup.md). None of these are secrets.
# API: validates access tokens issued by this tenant for this audience.
AUTH0_DOMAIN=dev-gz88acww7rvzqpc5.us.auth0.com
# Identifier of YOUR API in Auth0 (Applications > APIs), e.g.
# https://api.starter.local. Not the Management API (.../api/v2/).
AUTH0_AUDIENCE=https://api.starter.local
AUTH0_EMAIL_CLAIM=https://starter.local/email

# Web: same tenant and audience, plus the SPA application's Client ID.
VITE_AUTH0_DOMAIN=dev-gz88acww7rvzqpc5.us.auth0.com
VITE_AUTH0_CLIENT_ID=yw7oGXrbiyZ0zBNBCSMFKGra2uplAxhJ
VITE_AUTH0_AUDIENCE=https://api.starter.local
