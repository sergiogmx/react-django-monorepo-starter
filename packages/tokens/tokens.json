{
  "color": {
    "$type": "color",
    "primary": {
      "50": { "$value": "#eef2ff" },
      "100": { "$value": "#e0e7ff" },
      "500": { "$value": "#6366f1" },
      "600": { "$value": "#4f46e5" },
      "700": { "$value": "#4338ca" }
    },
    "neutral": {
      "50": { "$value": "#f8fafc" },
      "100": { "$value": "#f1f5f9" },
      "200": { "$value": "#e2e8f0" },
      "500": { "$value": "#64748b" },
      "700": { "$value": "#334155" },
      "900": { "$value": "#0f172a" }
    },
    "danger": {
      "600": { "$value": "#dc2626" },
      "700": { "$value": "#b91c1c" }
    },
    "success": {
      "600": { "$value": "#16a34a" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["ui-sans-serif", "system-ui", "sans-serif"] },
    "mono": { "$value": ["ui-monospace", "SFMono-Regular", "monospace"] }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": { "value": 0.25, "unit": "rem" },
      "$description": "Base unit; Tailwind multiplies it (p-4 = 4 x base)."
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 0.25, "unit": "rem" } },
    "md": { "$value": { "value": 0.5, "unit": "rem" } },
    "lg": { "$value": { "value": 0.75, "unit": "rem" } }
  }
}
